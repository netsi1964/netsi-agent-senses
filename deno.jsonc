{
  "tasks": {
    "test": "deno test --permit-no-files --allow-read --allow-write=.netsi-agent-senses",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["**/*.md"]
  },
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
